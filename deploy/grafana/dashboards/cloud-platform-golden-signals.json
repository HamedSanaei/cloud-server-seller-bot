{
  "title": "Cloud Platform - Golden Signals",
  "uid": "cloud-platform-golden-signals",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["cloud-platform", "golden-signals"],
  "timezone": "browser",
  "time": { "from": "now-3h", "to": "now" },
  "refresh": "30s",
  "editable": true,
  "graphTooltip": 1,
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "The Prometheus instance scraping the platform /metrics endpoints",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "provider",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(cloud_platform_provider_calls_total, provider)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "LATENCY",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API request duration (p50 / p95 / p99)",
      "description": "Golden signal: latency of customer-facing API requests.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p50",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(cloud_platform_api_request_duration_seconds_bucket[5m])))"
        },
        {
          "refId": "B",
          "legendFormat": "p95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(cloud_platform_api_request_duration_seconds_bucket[5m])))"
        },
        {
          "refId": "C",
          "legendFormat": "p99",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(cloud_platform_api_request_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Provider call duration p95 by provider",
      "description": "Golden signal: latency of outbound provider API calls (Hetzner, ArvanCloud).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{provider}}",
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(cloud_platform_provider_call_duration_seconds_bucket[5m]) or vector(0)))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Job duration p95 by job",
      "description": "Background worker job run latency (accrual, reconciliation, provisioning, backup).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{job}}",
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(cloud_platform_job_duration_seconds_bucket[15m]) or vector(0)))"
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "TRAFFIC",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "API request rate by status",
      "description": "Golden signal: traffic - customer-facing request volume, split by status class.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{status}}",
          "expr": "sum by (status) (rate(cloud_platform_api_requests_total[5m]))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Provider call rate by provider and outcome",
      "description": "Golden signal: traffic of outbound provider mutations and reads.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{provider}} {{outcome}}",
          "expr": "sum by (provider, outcome) (rate(cloud_platform_provider_calls_total{provider=~\"$provider\"}[5m]))"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Job run rate by status",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{job}} {{status}}",
          "expr": "sum by (job, status) (rate(cloud_platform_job_runs_total[15m]))"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Billing event rate by event and result",
      "description": "Hold/charge fund events - the money-moving surface of the platform.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{event}} {{result}}",
          "expr": "sum by (event, result) (rate(cloud_platform_billing_events_total[15m]))"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "ERRORS",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "API 5xx rate",
      "description": "Golden signal: errors - server-side failures of customer-facing requests.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "fixed", "fixedColor": "red" }, "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "5xx",
          "expr": "sum (rate(cloud_platform_api_requests_total{status=~\"5..\"}[5m]))"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Provider error rate by outcome",
      "description": "Golden signal: errors - auth, 404, conflict, rate-limit (429), unavailable, other.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{outcome}}",
          "expr": "sum by (outcome) (rate(cloud_platform_provider_calls_total{outcome!=\"success\"}[5m]))"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Job error rate by job",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 43 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{job}}",
          "expr": "sum by (job) (rate(cloud_platform_job_runs_total{status=\"error\"}[15m]))"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Provisioning failures by stage",
      "description": "Permanent create-intent failures, split by the stage that detected them.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 43 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{stage}}",
          "expr": "sum by (stage) (rate(cloud_platform_provisioning_failures_total[1h]))"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Reconciliation outcomes by reconciler",
      "description": "Drift detection health: applied / failed / marked_for_review per reconciler.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 51 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{reconciler}} {{outcome}}",
          "expr": "sum by (reconciler, outcome) (rate(cloud_platform_reconciliation_outcomes_total[1h]))"
        }
      ]
    },
    {
      "id": 16,
      "type": "row",
      "title": "SATURATION",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 59 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Oldest pending operation age",
      "description": "Golden signal: saturation - how long a provider-mutating intent has been waiting.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 60 },
      "fieldConfig": {
        "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 300 }, { "color": "red", "value": 1800 } ] }, "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{operation_type}}",
          "expr": "max by (operation_type) (cloud_platform_operation_queue_age_seconds)"
        }
      ]
    },
    {
      "id": 18,
      "type": "stat",
      "title": "Daily provider cost (minor units)",
      "description": "Saturation of the cost envelope: current UTC-day spend vs the cost circuit breaker.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 60 },
      "fieldConfig": {
        "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }, "color": { "mode": "thresholds" } },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "legendFormat": "global", "expr": "cloud_platform_daily_global_provider_cost_minor" },
        {
          "refId": "B",
          "legendFormat": "{{provider}}",
          "expr": "cloud_platform_daily_provider_cost_minor{provider=~\"$provider\"}"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Provider rate-limit (429) rate by provider",
      "description": "Saturation of provider quotas: sustained 429s mean the platform is pushing a provider too hard.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 68 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{provider}}",
          "expr": "sum by (provider) (rate(cloud_platform_provider_calls_total{outcome=\"rate_limited\"}[5m]))"
        }
      ]
    }
  ]
}
