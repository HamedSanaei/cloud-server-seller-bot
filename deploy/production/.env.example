[TEMPLATE]
# Production deployment values - copy to .env and fill in. NEVER commit .env.
#
# This file deliberately holds INFRASTRUCTURE values only. Every application
# setting and secret lives in configuration.toml (mounted read-only at
# /etc/cloud-server-seller/configuration.toml), so no provider key, bot token,
# payment secret or encryption key ever appears in the environment.

# The immutable release image: ghcr.io/<org>/<repo>:<FULL-GIT-SHA>.
# Automated deployments (GitHub Actions) update ONLY this value in the
# server-side deploy.env. Never use a mutable tag (e.g. "latest") here:
# production must always run the exact CI-tested commit.
PLATFORM_IMAGE=registry.example.com/cloud-server-platform:0000000000000000000000000000000000000000

# PostgreSQL password. Must match the password inside configuration.toml's
# [database] url (postgresql+asyncpg://cloud:<password>@postgres:5432/cloud).
# Empty fails fast at deploy time; generate one with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Optional: host port for the REST API.
API_PORT=8000

# Optional: server-owned application configuration file (mounted read-only
# into every container). The default is the documented server path; set this
# only when the file lives elsewhere.
# CONFIGURATION_PATH=/etc/cloud-server-seller/configuration.toml
