# Staging configuration - copy to .env and fill in. NEVER commit the real .env.
# (this file ships in the repo on purpose; .env itself is git-ignored)

# The immutable release image from M12-002: registry/repository:FULL-GIT-SHA
PLATFORM_IMAGE=registry.example.com/cloud-server-platform:0000000000000000000000000000000000000000

# Staging PostgreSQL password (any strong value; state is on the pgdata volume)
STAGING_DB_PASSWORD=change-me-strong-password

# Secrets (empty values are allowed in staging where the integration is not wired)
STAGING_TELEGRAM_BOT_TOKEN=
STAGING_CALLBACK_SIGNING_KEY=
STAGING_PRICE_BOOK_NAME=retail-eur
STAGING_HETZNER_API_TOKEN=
STAGING_HETZNER_API_BASE_URL=https://api.hetzner.cloud/v1
STAGING_LEASEWEB_API_KEY=
STAGING_LEASEWEB_API_BASE_URL=https://api.leaseweb.com
STAGING_LEASEWEB_LOCATIONS=AMS-01,FRA-01
STAGING_LEASEWEB_OS_ALLOWLIST=
STAGING_LEASEWEB_ORDER_OS_ONLY_FREE=true
STAGING_LEASEWEB_ALLOW_LIVE_ORDER_TEST=false
STAGING_TELEGRAM_ADMIN_CHAT_ID=0
STAGING_SUPPORT_CONTACT=
STAGING_ZARINPAL_MERCHANT_ID=
STAGING_ZARINPAL_SANDBOX=true
STAGING_ZARINPAL_CALLBACK_URL=
STAGING_ARVANCLOUD_API_KEY=
STAGING_ARVANCLOUD_REGION=
# 32-byte url-safe base64 key (e.g. `python -c "import base64; from cloud_platform.core.secrets import MasterKey; print(base64.urlsafe_b64encode(MasterKey.generate().material).decode())"`)
STAGING_PROVIDER_CREDENTIAL_KEY=

# Backup encryption key (32-byte url-safe base64, as above)
STAGING_BACKUP_ENCRYPTION_KEY=
STAGING_BACKUP_RETENTION_DAYS=14

# Optional overrides
STAGING_API_PORT=8000
STAGING_DEFAULT_CURRENCY=EUR