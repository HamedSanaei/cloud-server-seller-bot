APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://cloud:cloud@localhost:5432/cloud
REDIS_URL=redis://localhost:6379/0
TELEGRAM_BOT_TOKEN=
CALLBACK_SIGNING_KEY=
# --- Providers: configure one or both sellable EU providers ---
HETZNER_API_TOKEN=
HETZNER_API_BASE_URL=https://api.hetzner.cloud/v1
LEASEWEB_API_KEY=
LEASEWEB_API_BASE_URL=https://api.leaseweb.com
# --- Leaseweb monthly VPS storefront (LEASEWEB-MVP) ---
# Locations synced/sold (comma-separated allowlist).
LEASEWEB_LOCATIONS=AMS-01,FRA-01
# Optional OS allowlist (comma-separated); empty = every free OS option.
LEASEWEB_OS_ALLOWLIST=
# Only OS options that do not change the base monthly price are sellable.
LEASEWEB_ORDER_OS_ONLY_FREE=true
# SAFETY SWITCH: must be explicitly true for any code path to place a REAL
# billable Leaseweb order (tests/dev never order; default false).
LEASEWEB_ALLOW_LIVE_ORDER_TEST=false
# Telegram admin alert chat for renewals/attention (0 = unset).
TELEGRAM_ADMIN_CHAT_ID=0
# Optional support contact shown on the support screen (e.g. @handle).
SUPPORT_CONTACT=
# --- Optional Iranian provider (ArvanCloud IaaS) ---
ARVANCLOUD_API_KEY=
ARVANCLOUD_API_BASE_URL=https://napi.arvancloud.ir/ecc/v1
ARVANCLOUD_REGION=
# --- Payments: first Iranian gateway is ZarinPal ---
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_BASE_URL=https://api.zarinpal.com/pg/v4/payment
ZARINPAL_CALLBACK_URL=
# gateway webhook HMAC secrets, e.g. {"zarinpal": "<random-32-bytes-hex>"}
PAYMENT_GATEWAY_SECRETS=
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=
DEFAULT_CURRENCY=EUR
PRICE_BOOK_NAME=retail-eur
CUSTOMER_BILLING_QUANTUM_SECONDS=3600
