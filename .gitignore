# --- Environment & secrets (local only; .env.example stays tracked) ---
.env
.env.local
.env.*.local
!.env.example
.envrc

# --- Runtime configuration (the real TOML holds secrets; the example ships) ---
configuration.toml
config/configuration.toml
!configuration.example.toml
!deploy/**/configuration.example.toml

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Tool caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.pytype/

# --- Coverage ---
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# --- Generated CI/test reports (never commit) ---
# JUnit XML / coverage XML / generated reports are build artifacts.
# They are produced by local validation and CI runs and must never be
# source-controlled (a generated report once broke pre-commit via
# detect-secrets/end-of-file-fixer). Keep patterns narrow: do NOT use a
# broad "*.xml" rule because legitimate XML fixtures may exist.
pytest-results.xml
junit.xml
.ci-artifacts/
test-results/

# --- Databases & local data ---
*.sqlite3
*.sqlite3-*
*.sqlite
*.db
*.db3
*.log
*.pid

# --- Local state / logs ---
logs/
tmp/

# --- Editor / OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini


api_docs/leaseweb
